@BlockMosh
--dialog:Map,map=0;Mode,mode=0;Block,block=32;Intensity,intensity=64;Carry,carry=58;Smear,smear=42;Threshold,threshold=38;Drop,drop=12;Chroma,chroma=7;Alpha,alpha=100;Seed,seed=1;Tint/col,tint=0x82e8ff;Base/chk,base=1;Debug/chk,debug=0;Invert/chk,invert=0;MaskOnly/chk,mask_only=0

local ok, core = false, nil
if type(require) == "function" then
  ok, core = pcall(require, "block_mosh_core")
end

obj.load("framebuffer")
local data, w, h = obj.getpixeldata()
if not (ok and core and core.apply and data and w and h and w > 0 and h > 0) then
  obj.draw()
  return
end

core.apply(
  data, w, h,
  map or 0,
  mode or 0,
  block or 32,
  intensity or 64,
  carry or 58,
  smear or 42,
  threshold or 38,
  drop or 12,
  chroma or 7,
  alpha or 100,
  seed or 1,
  tint or 0x82e8ff,
  base or 1,
  debug or 0,
  invert or 0,
  mask_only or 0,
  obj.time or 0
)

obj.putpixeldata(data)
obj.draw()
